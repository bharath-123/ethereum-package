# Builder Whitelist Configuration for Prysm
# Generated by ethereum-package
#
# When GetHeader is called, the beacon node will query all builders in parallel and
# select the bid with the highest value (that meets the min_bid threshold).

builders:
{{- range $builder := .Builders }}
  - url: "{{ $builder.URL }}"
    min_bid: {{ $builder.MinBid }}
{{- end }}
